{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://private.meego-plugin/schemas/fixture.schema.json",
  "title": "Meego Plugin Capability Fixture",
  "type": "object",
  "required": ["id", "capabilityId", "kind", "cases"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "http_api",
        "plugin_point",
        "jssdk_api",
        "event_contract",
        "ai_capability"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "outcome", "description"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": ["success", "failure", "source_silent"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "object"
          },
          "input": {
            "type": "object"
          },
          "response": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "sourceSilence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "source_silent"
                }
              },
              "required": ["outcome"]
            },
            "then": {
              "required": ["sourceSilence"]
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": ["success", "failure"]
                }
              },
              "required": ["outcome"]
            },
            "then": {
              "anyOf": [
                {"required": ["request", "response"]},
                {"required": ["input", "output"]}
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "http_api"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "if": {
                "properties": {
                  "outcome": {
                    "enum": ["success", "failure"]
                  }
                },
                "required": ["outcome"]
              },
              "then": {
                "required": ["request", "response"]
              }
            }
          }
        }
      }
  },
  {
    "if": {
      "properties": {
        "kind": {
          "const": "event_contract"
        },
        "capabilityId": {
          "const": "event-contract.webhook-signature"
        }
      },
      "required": ["kind", "capabilityId"]
    },
    "then": {
      "properties": {
        "cases": {
          "items": {
            "if": {
              "properties": {
                "outcome": {
                  "enum": ["success", "failure"]
                }
              },
              "required": ["outcome"]
            },
            "then": {
              "required": ["input", "output"]
            }
          }
        }
      }
    }
  },
  {
    "if": {
      "properties": {
        "kind": {
          "const": "event_contract"
        },
        "capabilityId": {
          "not": {
            "const": "event-contract.webhook-signature"
          }
        }
      },
      "required": ["kind", "capabilityId"]
    },
    "then": {
      "properties": {
        "cases": {
          "items": {
            "if": {
              "properties": {
                "outcome": {
                  "enum": ["success", "failure"]
                }
              },
              "required": ["outcome"]
            },
            "then": {
              "required": ["request", "response"]
            }
          }
        }
      }
    }
  },
  {
      "if": {
        "properties": {
          "kind": {
            "enum": ["plugin_point", "jssdk_api"]
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "if": {
                "properties": {
                  "outcome": {
                    "enum": ["success", "failure"]
                  }
                },
                "required": ["outcome"]
              },
              "then": {
                "required": ["input", "output"]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
