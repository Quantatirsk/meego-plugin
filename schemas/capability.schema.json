{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://private.meego-plugin/schemas/capability.schema.json",
  "title": "Meego Plugin Capability",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "officialUrl",
    "docPath",
    "docAnchor",
    "status",
    "usageFrequency",
    "frequencyBasis",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "http_api",
        "plugin_point",
        "jssdk_api",
        "event_contract",
        "ai_capability"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "officialUrl": {
      "type": "string",
      "format": "uri"
    },
    "docPath": {
      "type": "string",
      "pattern": "^docs/.+\\.md$"
    },
    "docAnchor": {
      "type": "string",
      "pattern": "^capability-[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "verified",
        "source_silent",
        "needs_runtime_validation",
        "deprecated"
      ]
    },
    "usageFrequency": {
      "enum": ["high", "medium", "low"]
    },
    "frequencyBasis": {
      "const": "local-static-heuristic"
    },
    "sourceSilenceEvidence": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "fixtureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "contract": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["contract", "fixtureIds"],
        "properties": {
          "fixtureIds": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "source_silent"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["sourceSilenceEvidence"]
      },
      "else": {
        "not": {
          "required": ["sourceSilenceEvidence"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "http_api"
          }
        },
        "required": ["kind", "contract"]
      },
      "then": {
        "properties": {
          "contract": {
            "required": ["operation", "auth", "permissions", "preconditions"],
            "properties": {
              "operation": {
                "type": "object",
                "required": ["method", "path"],
                "properties": {
                  "method": {
                    "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^/"
                  }
                },
                "additionalProperties": true
              },
              "auth": {
                "type": "array"
              },
              "permissions": {
                "type": "array"
              },
              "preconditions": {
                "type": "array"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plugin_point"
          }
        },
        "required": ["kind", "contract"]
      },
      "then": {
        "properties": {
          "contract": {
            "required": ["point", "resource", "runtime"],
            "properties": {
              "point": {
                "type": "string"
              },
              "resource": {
                "type": "object"
              },
              "runtime": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "jssdk_api"
          }
        },
        "required": ["kind", "contract"]
      },
      "then": {
        "properties": {
          "contract": {
            "required": ["namespace", "methods", "supportedPoints"],
            "properties": {
              "namespace": {
                "type": "string"
              },
              "methods": {
                "type": "array",
                "minItems": 1
              },
              "supportedPoints": {
                "type": "array"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "event_contract"
          }
        },
        "required": ["kind", "contract"]
      },
      "then": {
        "properties": {
          "contract": {
            "required": ["delivery", "verification", "acknowledgement"],
            "properties": {
              "delivery": {
                "type": "object"
              },
              "verification": {
                "type": "object"
              },
              "acknowledgement": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ai_capability"
          }
        },
        "required": ["kind", "contract"]
      },
      "then": {
        "properties": {
          "contract": {
            "required": ["capability", "lifecycle", "permissions"],
            "properties": {
              "capability": {
                "type": "string"
              },
              "lifecycle": {
                "type": "array"
              },
              "permissions": {
                "type": "array"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
